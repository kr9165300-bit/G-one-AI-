# Google Gemini API key - NEVER commit your real key to GitHub
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: protect your own /api/g-one-ai/chat endpoint
G_ONE_AI_API_KEY=YOUR_OWN_API_KEY

# Render supplies PORT automatically; keep this only for local testing
PORT=10000
